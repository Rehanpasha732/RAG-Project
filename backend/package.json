{
  "name": "docxtract-backend",
  "version": "1.0.0",
  "description": "Document upload and text extraction API",
  "main": "dist/server.js",
  "scripts": {
    "build": "node api.js && tsc",
    "start": "node api.js && node dist/server.js",
    "dev": "node api.js && tsx watch src/server.ts",
    "dev:nodemon": "nodemon --exec tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.8.0",
    "mongodb": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "ollama": "^0.6.3",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
